{
  "rewrites": [
    {
      "source": "/dev",
      "destination": "/dev.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "dev",
          "value": "true"
        }
      ],
      "destination": "/dev.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "admin",
          "value": "dev"
        }
      ],
      "destination": "/dev.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "bypass",
          "value": "true"
        }
      ],
      "destination": "/dev.html"
    },
    {
      "source": "/cf-stream/:match*",
      "destination": "https://customer-6i2z59dst7q6iswv.cloudflarestream.com/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(index.html|dev.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
